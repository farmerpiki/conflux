@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(PkgConfig REQUIRED)

if(@CONFLUX_INSTALL_NEEDS_LIBURING@)
    pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing)
endif()
if(@CONFLUX_INSTALL_NEEDS_XXHASH@)
    pkg_check_modules(XXHASH REQUIRED IMPORTED_TARGET libxxhash)
endif()
if(@CONFLUX_INSTALL_NEEDS_LIBPQ@)
    pkg_check_modules(LIBPQ REQUIRED IMPORTED_TARGET libpq)
endif()
if(@CONFLUX_INSTALL_NEEDS_OPENSSL@)
    find_dependency(OpenSSL REQUIRED)
endif()
if(@CONFLUX_INSTALL_NEEDS_ZLIB@)
    find_dependency(ZLIB REQUIRED)
endif()
if(@CONFLUX_INSTALL_NEEDS_LIBDEFLATE@)
    pkg_check_modules(LIBDEFLATE REQUIRED IMPORTED_TARGET libdeflate)
endif()
if(@CONFLUX_INSTALL_NEEDS_ZLIB_NG@)
    pkg_check_modules(ZLIB_NG REQUIRED IMPORTED_TARGET zlib-ng)
endif()
if(@CONFLUX_INSTALL_NEEDS_ISAL@)
    pkg_check_modules(LIBISAL REQUIRED IMPORTED_TARGET libisal)
endif()
if(@CONFLUX_INSTALL_NEEDS_BROTLI@)
    pkg_check_modules(BROTLI REQUIRED IMPORTED_TARGET libbrotlienc libbrotlidec)
endif()
if(@CONFLUX_INSTALL_NEEDS_ZSTD@)
    pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
endif()
if(@CONFLUX_INSTALL_NEEDS_NGHTTP2@)
    pkg_check_modules(NGHTTP2 REQUIRED IMPORTED_TARGET libnghttp2)
endif()
if(@CONFLUX_INSTALL_NEEDS_NGTCP2@)
    pkg_check_modules(NGTCP2 REQUIRED IMPORTED_TARGET libngtcp2)
    pkg_check_modules(NGTCP2_CRYPTO_OSSL REQUIRED IMPORTED_TARGET libngtcp2_crypto_ossl)
endif()
if(@CONFLUX_INSTALL_NEEDS_NGHTTP3@)
    pkg_check_modules(NGHTTP3 REQUIRED IMPORTED_TARGET libnghttp3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/confluxTargets.cmake")
check_required_components(conflux)
