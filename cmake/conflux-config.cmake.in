@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_conflux_needs_pkgconfig FALSE)
if(@CONFLUX_INSTALL_NEEDS_LIBURING@
        OR @CONFLUX_INSTALL_NEEDS_XXHASH@
        OR @CONFLUX_INSTALL_NEEDS_LIBPQ@
        OR @CONFLUX_INSTALL_NEEDS_LIBDEFLATE@
        OR @CONFLUX_INSTALL_NEEDS_ZLIB_NG@
        OR @CONFLUX_INSTALL_NEEDS_ISAL@
        OR @CONFLUX_INSTALL_NEEDS_BROTLI@
        OR @CONFLUX_INSTALL_NEEDS_ZSTD@
        OR @CONFLUX_INSTALL_NEEDS_NGHTTP2@
        OR @CONFLUX_INSTALL_NEEDS_NGTCP2@
        OR @CONFLUX_INSTALL_NEEDS_NGHTTP3@)
    set(_conflux_needs_pkgconfig TRUE)
endif()
if(_conflux_needs_pkgconfig)
    find_dependency(PkgConfig REQUIRED)
endif()

if(@CONFLUX_INSTALL_NEEDS_LIBURING@)
    pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing)
endif()
if(@CONFLUX_INSTALL_NEEDS_XXHASH@)
    pkg_check_modules(XXHASH REQUIRED IMPORTED_TARGET libxxhash)
endif()
if(@CONFLUX_INSTALL_NEEDS_LIBPQ@)
    pkg_check_modules(LIBPQ REQUIRED IMPORTED_TARGET libpq)
endif()
if(@CONFLUX_INSTALL_NEEDS_OPENSSL@)
    find_dependency(OpenSSL REQUIRED)
endif()
if(@CONFLUX_INSTALL_NEEDS_ZLIB@)
    find_dependency(ZLIB REQUIRED)
endif()
if(@CONFLUX_INSTALL_NEEDS_LIBDEFLATE@)
    pkg_check_modules(LIBDEFLATE REQUIRED IMPORTED_TARGET libdeflate)
endif()
if(@CONFLUX_INSTALL_NEEDS_ZLIB_NG@)
    pkg_check_modules(ZLIB_NG REQUIRED IMPORTED_TARGET zlib-ng)
endif()
if(@CONFLUX_INSTALL_NEEDS_ISAL@)
    pkg_check_modules(LIBISAL REQUIRED IMPORTED_TARGET libisal)
endif()
if(@CONFLUX_INSTALL_NEEDS_BROTLI@)
    pkg_check_modules(BROTLI REQUIRED IMPORTED_TARGET libbrotlienc libbrotlidec)
endif()
if(@CONFLUX_INSTALL_NEEDS_ZSTD@)
    pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
endif()
if(@CONFLUX_INSTALL_NEEDS_NGHTTP2@)
    pkg_check_modules(NGHTTP2 REQUIRED IMPORTED_TARGET libnghttp2)
endif()
if(@CONFLUX_INSTALL_NEEDS_NGTCP2@)
    pkg_check_modules(NGTCP2 REQUIRED IMPORTED_TARGET libngtcp2)
    pkg_check_modules(NGTCP2_CRYPTO_OSSL REQUIRED IMPORTED_TARGET libngtcp2_crypto_ossl)
endif()
if(@CONFLUX_INSTALL_NEEDS_NGHTTP3@)
    pkg_check_modules(NGHTTP3 REQUIRED IMPORTED_TARGET libnghttp3)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/confluxTargets.cmake")

set(conflux_VERSION "@PROJECT_VERSION@")
set(CONFLUX_INTERFACE_MODE "@CONFLUX_INTERFACE_MODE@")
set(CONFLUX_PACKAGE_MOCK_LIBURING "@CONFLUX_USE_MOCK_LIBURING@")
set(CONFLUX_RUNTIME_REQUIRES_LIBURING "@CONFLUX_INSTALL_NEEDS_LIBURING@")
set(CONFLUX_RUNTIME_MOCK "@CONFLUX_INSTALL_MOCK_RUNTIME@")
set(conflux_AVAILABLE_COMPONENTS "@CONFLUX_PACKAGE_COMPONENTS@")
set(conflux_AVAILABLE_TARGETS "@CONFLUX_PACKAGE_TARGETS@")

if(CONFLUX_INTERFACE_MODE STREQUAL "MODULE_INTERFACE")
    if(TARGET conflux::core)
        target_compile_definitions(conflux::core INTERFACE CONFLUX_INTERFACE_MODULE=1)
    endif()
elseif(CONFLUX_INTERFACE_MODE STREQUAL "HEADER_INTERFACE")
    if(TARGET conflux::core)
        target_compile_definitions(conflux::core INTERFACE CONFLUX_INTERFACE_HEADER=1)
    endif()
else()
    message(FATAL_ERROR
        "conflux package has unknown CONFLUX_INTERFACE_MODE='${CONFLUX_INTERFACE_MODE}'")
endif()

if(TARGET conflux::umbrella AND NOT TARGET conflux::conflux)
    add_library(conflux::conflux INTERFACE IMPORTED)
    set_target_properties(conflux::conflux PROPERTIES
        INTERFACE_LINK_LIBRARIES conflux::umbrella)
    list(APPEND conflux_AVAILABLE_COMPONENTS conflux)
    list(APPEND conflux_AVAILABLE_TARGETS conflux::conflux)
endif()

foreach(_conflux_component IN LISTS conflux_FIND_COMPONENTS)
    if(_conflux_component STREQUAL "conflux")
        set(_conflux_component_target conflux::conflux)
    else()
        set(_conflux_component_target "conflux::${_conflux_component}")
    endif()

    if(NOT _conflux_component IN_LIST conflux_AVAILABLE_COMPONENTS)
        set(conflux_${_conflux_component}_FOUND FALSE)
        if(NOT conflux_NOT_FOUND_MESSAGE)
            set(conflux_NOT_FOUND_MESSAGE
                "conflux component '${_conflux_component}' was requested but is not available in this install tree")
        endif()
    elseif(NOT TARGET ${_conflux_component_target})
        set(conflux_${_conflux_component}_FOUND FALSE)
        if(NOT conflux_NOT_FOUND_MESSAGE)
            set(conflux_NOT_FOUND_MESSAGE
                "conflux component '${_conflux_component}' is listed in this install tree but target '${_conflux_component_target}' is missing")
        endif()
    else()
        set(conflux_${_conflux_component}_FOUND TRUE)
    endif()
endforeach()

check_required_components(conflux)
