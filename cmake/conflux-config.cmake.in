@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(conflux_VERSION "@PROJECT_VERSION@")
set(CONFLUX_INTERFACE_MODE "@CONFLUX_INTERFACE_MODE@")
set(CONFLUX_USE_IMPORT_STD "@CONFLUX_IMPORT_STD_ENABLED@")
set(CONFLUX_RUNTIME_REQUIRES_LIBURING "@CONFLUX_INSTALL_NEEDS_LIBURING@")
set(CONFLUX_PACKAGE_HAS_METRICS "@CONFLUX_HAS_METRICS@")

include("${CMAKE_CURRENT_LIST_DIR}/conflux-component-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/conflux-component-deps.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/conflux-component-external-deps.cmake")

set(conflux_AVAILABLE_COMPONENTS "${_conflux_requestable_components}")
set(conflux_AVAILABLE_TARGETS "${_conflux_requestable_targets}")
set(conflux_AVAILABLE_SUPPORT_TARGETS "${_conflux_support_targets}")
set(conflux_VISIBLE_COMPONENTS)
set(conflux_VISIBLE_TARGETS)
set(conflux_VISIBLE_SUPPORT_TARGETS)
set(conflux_RESOLVED_EXTERNAL_DEPS)

function(_conflux_find_external_dep token)
    if(token IN_LIST conflux_RESOLVED_EXTERNAL_DEPS)
        return()
    endif()

    if(token STREQUAL "LIBURING")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing)
    elseif(token STREQUAL "XXHASH")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(XXHASH REQUIRED IMPORTED_TARGET libxxhash)
    elseif(token STREQUAL "LIBPQ")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(LIBPQ REQUIRED IMPORTED_TARGET libpq)
    elseif(token STREQUAL "OPENSSL")
        find_dependency(OpenSSL REQUIRED)
    elseif(token STREQUAL "ZLIB")
        find_dependency(ZLIB REQUIRED)
    elseif(token STREQUAL "LIBDEFLATE")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(LIBDEFLATE REQUIRED IMPORTED_TARGET libdeflate)
    elseif(token STREQUAL "ZLIB_NG")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(ZLIB_NG REQUIRED IMPORTED_TARGET zlib-ng)
    elseif(token STREQUAL "LIBISAL")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(LIBISAL REQUIRED IMPORTED_TARGET libisal)
    elseif(token STREQUAL "BROTLI")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(BROTLI REQUIRED IMPORTED_TARGET libbrotlienc libbrotlidec)
    elseif(token STREQUAL "ZSTD")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(ZSTD REQUIRED IMPORTED_TARGET libzstd)
    elseif(token STREQUAL "NGHTTP2")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(NGHTTP2 REQUIRED IMPORTED_TARGET libnghttp2)
    elseif(token STREQUAL "NGTCP2")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(NGTCP2 REQUIRED IMPORTED_TARGET libngtcp2)
    elseif(token STREQUAL "NGTCP2_CRYPTO_OSSL")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(NGTCP2_CRYPTO_OSSL REQUIRED IMPORTED_TARGET libngtcp2_crypto_ossl)
    elseif(token STREQUAL "NGHTTP3")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(NGHTTP3 REQUIRED IMPORTED_TARGET libnghttp3)
    elseif(token STREQUAL "ARGON2")
        find_dependency(PkgConfig REQUIRED)
        pkg_check_modules(ARGON2 REQUIRED IMPORTED_TARGET libargon2)
    else()
        message(FATAL_ERROR "conflux package has unknown external dependency token '${token}'")
    endif()

    list(APPEND conflux_RESOLVED_EXTERNAL_DEPS "${token}")
    list(REMOVE_DUPLICATES conflux_RESOLVED_EXTERNAL_DEPS)
    set(conflux_RESOLVED_EXTERNAL_DEPS "${conflux_RESOLVED_EXTERNAL_DEPS}" PARENT_SCOPE)
endfunction()

function(_conflux_export_component out_var component)
    set(${out_var} "${component}" PARENT_SCOPE)
endfunction()

function(_conflux_component_target out_var component)
    set(${out_var} "conflux::${component}" PARENT_SCOPE)
endfunction()

function(_conflux_import_component component)
    if(component IN_LIST _conflux_imported_components)
        return()
    endif()
    if(component IN_LIST _conflux_import_stack)
        list(APPEND _conflux_import_stack "${component}")
        string(REPLACE ";" " -> " _cycle "${_conflux_import_stack}")
        message(FATAL_ERROR "conflux component dependency cycle: ${_cycle}")
    endif()
    if(NOT component IN_LIST _conflux_all_components)
        message(FATAL_ERROR
            "conflux component '${component}' is not registered in this install tree")
    endif()

    list(APPEND _conflux_import_stack "${component}")
    set(_conflux_import_stack "${_conflux_import_stack}" PARENT_SCOPE)

    foreach(_dep IN LISTS _conflux_component_deps_${component})
        _conflux_import_component("${_dep}")
    endforeach()

    foreach(_external IN LISTS _conflux_component_external_deps_${component})
        _conflux_find_external_dep("${_external}")
    endforeach()

    _conflux_export_component(_export_component "${component}")
    set(_conflux_export_file
        "${CMAKE_CURRENT_LIST_DIR}/confluxTargets-${_export_component}.cmake")
    if(NOT EXISTS "${_conflux_export_file}")
        message(FATAL_ERROR
            "conflux component '${component}' is listed in this install tree but export file '${_conflux_export_file}' is missing")
    endif()
    include("${_conflux_export_file}")

    list(APPEND _conflux_imported_components "${component}")
    set(_conflux_imported_components "${_conflux_imported_components}" PARENT_SCOPE)

    if(component IN_LIST _conflux_requestable_components)
        list(APPEND conflux_VISIBLE_COMPONENTS "${component}")
        _conflux_component_target(_target "${component}")
        list(APPEND conflux_VISIBLE_TARGETS "${_target}")
    elseif(component IN_LIST _conflux_support_components)
        set(_target "conflux::${component}")
        list(APPEND conflux_VISIBLE_SUPPORT_TARGETS "${_target}")
        list(APPEND conflux_VISIBLE_TARGETS "${_target}")
    endif()

    list(POP_BACK _conflux_import_stack)
    set(_conflux_import_stack "${_conflux_import_stack}" PARENT_SCOPE)
    set(conflux_VISIBLE_COMPONENTS "${conflux_VISIBLE_COMPONENTS}" PARENT_SCOPE)
    set(conflux_VISIBLE_TARGETS "${conflux_VISIBLE_TARGETS}" PARENT_SCOPE)
    set(conflux_VISIBLE_SUPPORT_TARGETS "${conflux_VISIBLE_SUPPORT_TARGETS}" PARENT_SCOPE)
    set(conflux_RESOLVED_EXTERNAL_DEPS "${conflux_RESOLVED_EXTERNAL_DEPS}" PARENT_SCOPE)
endfunction()

set(_conflux_requested_components ${conflux_FIND_COMPONENTS})
if(NOT _conflux_requested_components)
    set(_conflux_requested_components core)
endif()

set(_conflux_imported_components)
set(_conflux_import_stack)

foreach(_conflux_component IN LISTS _conflux_requested_components)
    if(NOT _conflux_component IN_LIST _conflux_requestable_components)
        set(conflux_${_conflux_component}_FOUND FALSE)
        if(NOT conflux_NOT_FOUND_MESSAGE)
            set(conflux_NOT_FOUND_MESSAGE
                "conflux component '${_conflux_component}' was requested but is not available in this install tree")
        endif()
    else()
        _conflux_import_component("${_conflux_component}")
    endif()
endforeach()

list(REMOVE_DUPLICATES conflux_VISIBLE_COMPONENTS)
list(REMOVE_DUPLICATES conflux_VISIBLE_TARGETS)
list(REMOVE_DUPLICATES conflux_VISIBLE_SUPPORT_TARGETS)
list(REMOVE_DUPLICATES conflux_RESOLVED_EXTERNAL_DEPS)

if(CONFLUX_INTERFACE_MODE STREQUAL "MODULE_INTERFACE")
    if(TARGET conflux::core)
        target_compile_definitions(conflux::core INTERFACE
            CONFLUX_INTERFACE_MODULE=1
            CONFLUX_MODULE_USE_IMPORT_STD=$<BOOL:${CONFLUX_USE_IMPORT_STD}>)
    endif()
elseif(CONFLUX_INTERFACE_MODE STREQUAL "HEADER_INTERFACE")
    if(TARGET conflux::core)
        target_compile_definitions(conflux::core INTERFACE CONFLUX_INTERFACE_HEADER=1)
    endif()
else()
    message(FATAL_ERROR
        "conflux package has unknown CONFLUX_INTERFACE_MODE='${CONFLUX_INTERFACE_MODE}'")
endif()

if(TARGET conflux::umbrella AND NOT TARGET conflux::conflux)
    add_library(conflux::conflux INTERFACE IMPORTED)
    set_target_properties(conflux::conflux PROPERTIES
        INTERFACE_LINK_LIBRARIES conflux::umbrella)
endif()

function(_conflux_append_surface_definition out_var macro value)
    set(_defs ${${out_var}})
    list(APPEND _defs "CONFLUX_SURFACE_HAS_${macro}=${value}")
    set(${out_var} "${_defs}" PARENT_SCOPE)
endfunction()

set(_conflux_installed_surface_definitions
    CONFLUX_SURFACE_HAS_FEATURES=1)
foreach(_conflux_component IN LISTS conflux_VISIBLE_COMPONENTS)
    string(TOUPPER "${_conflux_component}" _conflux_surface_macro)
    list(APPEND _conflux_installed_surface_definitions
        "CONFLUX_SURFACE_HAS_${_conflux_surface_macro}=1")
endforeach()
if("http" IN_LIST conflux_VISIBLE_COMPONENTS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions HTTP_FACADE 1)
endif()
if("net_config" IN_LIST conflux_VISIBLE_COMPONENTS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions HTTP_CONFIG 1)
endif()
if("http_observability" IN_LIST conflux_VISIBLE_COMPONENTS
        AND CONFLUX_PACKAGE_HAS_METRICS STREQUAL "true")
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions HTTP_METRICS 1)
endif()
if("http_auth" IN_LIST conflux_VISIBLE_COMPONENTS
        AND "OPENSSL" IN_LIST conflux_RESOLVED_EXTERNAL_DEPS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions TLS_JWT 1)
endif()
if("template" IN_LIST conflux_VISIBLE_COMPONENTS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions TEMPLATES 1)
endif()
if("template_watch" IN_LIST conflux_VISIBLE_COMPONENTS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions TEMPLATES_WATCH 1)
endif()
if("pg" IN_LIST conflux_VISIBLE_COMPONENTS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions DB 1)
endif()
if("db" IN_LIST conflux_VISIBLE_COMPONENTS)
    _conflux_append_surface_definition(
        _conflux_installed_surface_definitions DB_COMPAT 1)
endif()
foreach(_conflux_visible_target IN LISTS conflux_VISIBLE_TARGETS)
    if(TARGET ${_conflux_visible_target})
        target_compile_definitions(${_conflux_visible_target} INTERFACE
            ${_conflux_installed_surface_definitions})
    endif()
endforeach()
if(TARGET conflux::headers)
    target_compile_definitions(conflux::headers INTERFACE
        ${_conflux_installed_surface_definitions})
endif()
unset(_conflux_installed_surface_definitions)

foreach(_conflux_component IN LISTS conflux_FIND_COMPONENTS)
    _conflux_component_target(_conflux_component_target "${_conflux_component}")

    if(NOT _conflux_component IN_LIST conflux_AVAILABLE_COMPONENTS)
        set(conflux_${_conflux_component}_FOUND FALSE)
        if(NOT conflux_NOT_FOUND_MESSAGE)
            set(conflux_NOT_FOUND_MESSAGE
                "conflux component '${_conflux_component}' was requested but is not available in this install tree")
        endif()
    elseif(NOT TARGET ${_conflux_component_target})
        set(conflux_${_conflux_component}_FOUND FALSE)
        if(NOT conflux_NOT_FOUND_MESSAGE)
            set(conflux_NOT_FOUND_MESSAGE
                "conflux component '${_conflux_component}' is listed in this install tree but target '${_conflux_component_target}' is missing")
        endif()
    else()
        set(conflux_${_conflux_component}_FOUND TRUE)
    endif()
endforeach()

check_required_components(conflux)
