cmake_policy(PUSH)
cmake_policy(SET CMP0057 NEW)

set(_conflux_install_prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(_conflux_package_dir
    "${_conflux_install_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/conflux")

set(_conflux_requestable_components "@CONFLUX_PACKAGE_COMPONENTS@")
set(_conflux_requestable_targets "@CONFLUX_PACKAGE_TARGETS@")
set(_conflux_support_components "@CONFLUX_PACKAGE_SUPPORT_COMPONENTS@")
set(_conflux_support_targets "@CONFLUX_PACKAGE_SUPPORT_TARGETS@")
set(_conflux_all_components "@CONFLUX_PACKAGE_ALL_COMPONENTS@")
set(_conflux_all_targets "@CONFLUX_PACKAGE_ALL_TARGETS@")

function(_conflux_fail message)
    message(FATAL_ERROR "conflux package metadata: ${message}")
endfunction()

function(_conflux_validate_parallel_lists components targets label)
    list(LENGTH ${components} _component_count)
    list(LENGTH ${targets} _target_count)
    if(NOT _component_count EQUAL _target_count)
        _conflux_fail(
            "${label} component/target lists differ in length: ${_component_count} components, ${_target_count} targets")
    endif()

    set(_seen_components)
    foreach(_component IN LISTS ${components})
        if(NOT _component MATCHES "^_?[A-Za-z][A-Za-z0-9_]*$")
            _conflux_fail(
                "${label} component '${_component}' cannot be used in generated CMake variable names")
        endif()
        if(_component IN_LIST _seen_components)
            _conflux_fail("${label} component '${_component}' is listed more than once")
        endif()
        list(APPEND _seen_components "${_component}")
    endforeach()

    set(_seen_targets)
    foreach(_target IN LISTS ${targets})
        if(NOT _target MATCHES "^conflux::[_A-Za-z][A-Za-z0-9_]*$")
            _conflux_fail(
                "${label} target '${_target}' is not a valid conflux namespaced target")
        endif()
        if(_target IN_LIST _seen_targets)
            _conflux_fail("${label} target '${_target}' is listed more than once")
        endif()
        list(APPEND _seen_targets "${_target}")
    endforeach()

    if(_component_count GREATER 0)
        math(EXPR _last_index "${_component_count} - 1")
        foreach(_index RANGE 0 ${_last_index})
            list(GET ${components} ${_index} _component)
            list(GET ${targets} ${_index} _target)
            set(_expected_target "conflux::${_component}")
            if(NOT _target STREQUAL _expected_target)
                _conflux_fail(
                    "${label} component '${_component}' must pair with target '${_expected_target}', got '${_target}'")
            endif()
        endforeach()
    endif()
endfunction()

function(_conflux_validate_component_partitions)
    set(_expected_all_components ${_conflux_requestable_components})
    list(APPEND _expected_all_components ${_conflux_support_components})
    if(_expected_all_components)
        list(SORT _expected_all_components)
    endif()

    set(_actual_all_components ${_conflux_all_components})
    if(_actual_all_components)
        list(SORT _actual_all_components)
    endif()

    if(NOT _expected_all_components STREQUAL _actual_all_components)
        _conflux_fail(
            "all component list must match requestable plus support components")
    endif()

    set(_expected_all_targets ${_conflux_requestable_targets})
    list(APPEND _expected_all_targets ${_conflux_support_targets})
    if(_expected_all_targets)
        list(SORT _expected_all_targets)
    endif()

    set(_actual_all_targets ${_conflux_all_targets})
    if(_actual_all_targets)
        list(SORT _actual_all_targets)
    endif()

    if(NOT _expected_all_targets STREQUAL _actual_all_targets)
        _conflux_fail(
            "all target list must match requestable plus support targets")
    endif()
endfunction()

_conflux_validate_parallel_lists(
    _conflux_requestable_components _conflux_requestable_targets requestable)
_conflux_validate_parallel_lists(
    _conflux_support_components _conflux_support_targets support)
_conflux_validate_parallel_lists(
    _conflux_all_components _conflux_all_targets all)
_conflux_validate_component_partitions()

function(_conflux_component_export_file out_var component)
    set(${out_var}
        "${_conflux_package_dir}/confluxTargets-${component}.cmake"
        PARENT_SCOPE)
endfunction()

function(_conflux_component_for_target out_var target)
    set(_index 0)
    foreach(_known_target IN LISTS _conflux_all_targets)
        if(_known_target STREQUAL "${target}")
            list(GET _conflux_all_components ${_index} _component)
            set(${out_var} "${_component}" PARENT_SCOPE)
            return()
        endif()
        math(EXPR _index "${_index} + 1")
    endforeach()
    set(${out_var} "" PARENT_SCOPE)
endfunction()

function(_conflux_normalize_link_item out_var item)
    set(_item "${item}")
    if(_item MATCHES "^\\\\\\$<")
        string(REGEX REPLACE "^\\\\" "" _item "${_item}")
    endif()
    if(_item MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
        set(_item "${CMAKE_MATCH_1}")
    elseif(_item MATCHES "^\\$<")
        _conflux_fail("unsupported generator expression '${item}'")
    endif()
    set(${out_var} "${_item}" PARENT_SCOPE)
endfunction()

function(_conflux_external_token_for_item out_var item)
    set(_token "")
    if(item STREQUAL "PkgConfig::LIBURING")
        set(_token LIBURING)
    elseif(item STREQUAL "PkgConfig::XXHASH")
        set(_token XXHASH)
    elseif(item STREQUAL "PkgConfig::LIBPQ")
        set(_token LIBPQ)
    elseif(item STREQUAL "OpenSSL::SSL" OR item STREQUAL "OpenSSL::Crypto")
        set(_token OPENSSL)
    elseif(item STREQUAL "ZLIB::ZLIB")
        set(_token ZLIB)
    elseif(item STREQUAL "PkgConfig::LIBDEFLATE")
        set(_token LIBDEFLATE)
    elseif(item STREQUAL "PkgConfig::ZLIB_NG")
        set(_token ZLIB_NG)
    elseif(item STREQUAL "PkgConfig::LIBISAL")
        set(_token LIBISAL)
    elseif(item STREQUAL "PkgConfig::BROTLI")
        set(_token BROTLI)
    elseif(item STREQUAL "PkgConfig::ZSTD")
        set(_token ZSTD)
    elseif(item STREQUAL "PkgConfig::NGHTTP2")
        set(_token NGHTTP2)
    elseif(item STREQUAL "PkgConfig::NGTCP2")
        set(_token NGTCP2)
    elseif(item STREQUAL "PkgConfig::NGTCP2_CRYPTO_OSSL")
        set(_token NGTCP2_CRYPTO_OSSL)
    elseif(item STREQUAL "PkgConfig::NGHTTP3")
        set(_token NGHTTP3)
    elseif(item STREQUAL "PkgConfig::ARGON2")
        set(_token ARGON2)
    elseif(item STREQUAL "dl" OR item STREQUAL "pthread" OR item STREQUAL "Threads::Threads")
        set(_token "")
    elseif(item MATCHES "::")
        if(NOT item MATCHES "^conflux::")
            _conflux_fail("unknown external provider target '${item}'")
        endif()
    endif()
    set(${out_var} "${_token}" PARENT_SCOPE)
endfunction()

function(_conflux_collect_export_metadata component export_file)
    file(READ "${export_file}" _content)

    set(_internal_deps)
    if(_content MATCHES "foreach\\(_target ([^\\)]*)\\)")
        set(_target_block "${CMAKE_MATCH_1}")
        string(REGEX MATCHALL "\"conflux::[^\"]+\"" _targets "${_target_block}")
        foreach(_quoted_target IN LISTS _targets)
            string(REGEX REPLACE "^\"|\"$" "" _target "${_quoted_target}")
            _conflux_component_for_target(_dep_component "${_target}")
            if(NOT _dep_component)
                _conflux_fail(
                    "export '${export_file}' references unknown internal target '${_target}'")
            endif()
            if(NOT _dep_component STREQUAL "${component}")
                list(APPEND _internal_deps "${_dep_component}")
            endif()
        endforeach()
    elseif(_content MATCHES "foreach\\(_target")
        _conflux_fail(
            "export '${export_file}' has an unrecognized dependency-check block")
    endif()
    if(_internal_deps)
        list(REMOVE_DUPLICATES _internal_deps)
        list(SORT _internal_deps)
    endif()
    set("_conflux_internal_${component}" "${_internal_deps}" PARENT_SCOPE)

    set(_external_deps)
    string(REGEX MATCHALL
        "(INTERFACE_LINK_LIBRARIES|IMPORTED_CXX_MODULES_LINK_LIBRARIES) \"[^\"]*\""
        _property_matches "${_content}")
    foreach(_property_match IN LISTS _property_matches)
        string(REGEX REPLACE "^[A-Z_]+ \"" "" _items "${_property_match}")
        string(REGEX REPLACE "\"$" "" _items "${_items}")
        if(_items)
            foreach(_item IN LISTS _items)
                _conflux_normalize_link_item(_normalized_item "${_item}")
                if(_normalized_item MATCHES "^conflux::")
                    _conflux_component_for_target(_dep_component "${_normalized_item}")
                    if(NOT _dep_component)
                        _conflux_fail(
                            "export '${export_file}' references unknown internal target '${_normalized_item}'")
                    endif()
                    if(NOT _dep_component STREQUAL "${component}")
                        list(APPEND _internal_deps "${_dep_component}")
                    endif()
                    continue()
                endif()
                _conflux_external_token_for_item(
                    _external_token "${_normalized_item}")
                if(_external_token)
                    list(APPEND _external_deps "${_external_token}")
                endif()
            endforeach()
        endif()
    endforeach()
    if(_external_deps)
        list(REMOVE_DUPLICATES _external_deps)
        list(SORT _external_deps)
    endif()
    set("_conflux_external_${component}" "${_external_deps}" PARENT_SCOPE)
endfunction()

foreach(_component IN LISTS _conflux_all_components)
    _conflux_component_export_file(_export_file "${_component}")
    if(NOT EXISTS "${_export_file}")
        _conflux_fail("missing export file '${_export_file}'")
    endif()
    _conflux_collect_export_metadata("${_component}" "${_export_file}")
endforeach()

set(_targets_file "${_conflux_package_dir}/conflux-component-targets.cmake")
set(_deps_file "${_conflux_package_dir}/conflux-component-deps.cmake")
set(_external_file "${_conflux_package_dir}/conflux-component-external-deps.cmake")

file(WRITE "${_targets_file}"
    "set(_conflux_requestable_components \"${_conflux_requestable_components}\")\n"
    "set(_conflux_requestable_targets \"${_conflux_requestable_targets}\")\n"
    "set(_conflux_support_components \"${_conflux_support_components}\")\n"
    "set(_conflux_support_targets \"${_conflux_support_targets}\")\n"
    "set(_conflux_all_components \"${_conflux_all_components}\")\n"
    "set(_conflux_all_targets \"${_conflux_all_targets}\")\n")

file(WRITE "${_deps_file}" "")
file(WRITE "${_external_file}" "")
foreach(_component IN LISTS _conflux_all_components)
    file(APPEND "${_deps_file}"
        "set(_conflux_component_deps_${_component} \"${_conflux_internal_${_component}}\")\n")
    file(APPEND "${_external_file}"
        "set(_conflux_component_external_deps_${_component} \"${_conflux_external_${_component}}\")\n")
endforeach()

cmake_policy(POP)
