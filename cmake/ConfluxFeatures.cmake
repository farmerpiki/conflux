    set(CONFLUX_HAS_BROTLI "false")
elseif(BROTLI_FOUND)
    set(CONFLUX_HAS_BROTLI "true")
    set(CONFLUX_RESOLVED_BROTLI_PROVIDER "SYSTEM" CACHE STRING "Resolved Brotli provider" FORCE)
