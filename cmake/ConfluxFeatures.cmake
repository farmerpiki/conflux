# ---------------------------------------------------------------------------
# Optional dependencies
# ---------------------------------------------------------------------------

include_guard(GLOBAL)

string(TOUPPER "${CONFLUX_TLS_PROVIDER}" CONFLUX_TLS_PROVIDER_UPPER)
if((CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT OR CONFLUX_WANT_HTTP_AUTH)
        AND NOT CONFLUX_TLS_PROVIDER_UPPER STREQUAL "OFF")
    find_package(OpenSSL)
endif()
if(CONFLUX_WANT_HTTP_COMPRESSION)
    find_package(ZLIB)
endif()

# ---- OpenSSL / TLS ---------------------------------------------------------
if(NOT CONFLUX_TLS_PROVIDER_UPPER MATCHES "^(AUTO|OPENSSL|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_TLS_PROVIDER must be AUTO, OPENSSL, or OFF "
        "(got '${CONFLUX_TLS_PROVIDER}')")
endif()
if((CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT OR CONFLUX_WANT_HTTP_AUTH)
        AND CONFLUX_TLS_PROVIDER_UPPER STREQUAL "OPENSSL"
        AND NOT OpenSSL_FOUND)
    message(FATAL_ERROR "conflux: CONFLUX_TLS_PROVIDER=OPENSSL requires OpenSSL")
endif()
if(NOT (CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT OR CONFLUX_WANT_HTTP_AUTH)
        OR CONFLUX_TLS_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_HAS_TLS "false")
elseif(OpenSSL_FOUND)
    set(CONFLUX_HAS_TLS "true")
    set(CONFLUX_RESOLVED_TLS_PROVIDER "OPENSSL" CACHE STRING "Resolved TLS provider" FORCE)
    message(STATUS "conflux: TLS enabled (OpenSSL ${OPENSSL_VERSION})")
else()
    set(CONFLUX_HAS_TLS "false")
    set(CONFLUX_RESOLVED_TLS_PROVIDER "OFF" CACHE STRING "Resolved TLS provider" FORCE)
    if(NOT OpenSSL_FOUND)
        message(STATUS "conflux: TLS disabled (OpenSSL not found)")
    endif()
endif()
if(NOT (CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT OR CONFLUX_WANT_HTTP_AUTH)
        OR CONFLUX_TLS_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_RESOLVED_TLS_PROVIDER "OFF" CACHE STRING "Resolved TLS provider" FORCE)
endif()

# ---- zlib / gzip -----------------------------------------------------------
string(TOUPPER "${CONFLUX_GZIP_PROVIDER}" CONFLUX_GZIP_PROVIDER_UPPER)
if(NOT CONFLUX_GZIP_PROVIDER_UPPER MATCHES "^(AUTO|ALL|LIBDEFLATE|ZLIB_NG|ZLIB|ISAL|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_GZIP_PROVIDER must be AUTO, ALL, LIBDEFLATE, ZLIB_NG, ZLIB, ISAL, or OFF "
        "(got '${CONFLUX_GZIP_PROVIDER}')")
endif()
set(_conflux_gzip_candidates)
if(CONFLUX_WANT_HTTP_COMPRESSION AND LIBDEFLATE_FOUND)
    list(APPEND _conflux_gzip_candidates LIBDEFLATE)
endif()
if(CONFLUX_WANT_HTTP_COMPRESSION AND ZLIB_NG_FOUND)
    list(APPEND _conflux_gzip_candidates ZLIB_NG)
endif()
if(CONFLUX_WANT_HTTP_COMPRESSION AND ZLIB_FOUND)
    list(APPEND _conflux_gzip_candidates ZLIB)
endif()
if(CONFLUX_WANT_HTTP_COMPRESSION AND LIBISAL_FOUND)
    list(APPEND _conflux_gzip_candidates ISAL)
endif()

set(CONFLUX_ENABLE_GZIP_ZLIB FALSE)
set(CONFLUX_ENABLE_GZIP_LIBDEFLATE FALSE)
set(CONFLUX_ENABLE_GZIP_ZLIB_NG FALSE)
set(CONFLUX_ENABLE_GZIP_ISAL FALSE)
set(_conflux_resolved_gzip_provider "OFF")
if(CONFLUX_WANT_HTTP_COMPRESSION AND NOT CONFLUX_GZIP_PROVIDER_UPPER STREQUAL "OFF")
    if(CONFLUX_GZIP_PROVIDER_UPPER STREQUAL "ALL")
        set(_conflux_selected_gzip_backends ${_conflux_gzip_candidates})
        set(_conflux_resolved_gzip_provider "ALL")
    elseif(CONFLUX_GZIP_PROVIDER_UPPER STREQUAL "AUTO")
        if(LIBDEFLATE_FOUND)
            set(_conflux_selected_gzip_backends LIBDEFLATE)
            set(_conflux_resolved_gzip_provider "LIBDEFLATE")
        elseif(ZLIB_NG_FOUND)
            set(_conflux_selected_gzip_backends ZLIB_NG)
            set(_conflux_resolved_gzip_provider "ZLIB_NG")
        elseif(ZLIB_FOUND)
            set(_conflux_selected_gzip_backends ZLIB)
            set(_conflux_resolved_gzip_provider "ZLIB")
        endif()
    else()
        list(FIND _conflux_gzip_candidates "${CONFLUX_GZIP_PROVIDER_UPPER}" _conflux_required_gzip_index)
        if(_conflux_required_gzip_index LESS 0)
            message(FATAL_ERROR
                "conflux: CONFLUX_GZIP_PROVIDER=${CONFLUX_GZIP_PROVIDER_UPPER} was requested but its provider was not found")
        endif()
        set(_conflux_selected_gzip_backends "${CONFLUX_GZIP_PROVIDER_UPPER}")
        set(_conflux_resolved_gzip_provider "${CONFLUX_GZIP_PROVIDER_UPPER}")
    endif()
endif()
set(CONFLUX_RESOLVED_GZIP_PROVIDER "${_conflux_resolved_gzip_provider}" CACHE STRING
    "Resolved gzip backend for this build" FORCE)
foreach(_backend IN LISTS _conflux_selected_gzip_backends)
    if(_backend STREQUAL "ZLIB")
        set(CONFLUX_ENABLE_GZIP_ZLIB TRUE)
    elseif(_backend STREQUAL "LIBDEFLATE")
        set(CONFLUX_ENABLE_GZIP_LIBDEFLATE TRUE)
    elseif(_backend STREQUAL "ZLIB_NG")
        set(CONFLUX_ENABLE_GZIP_ZLIB_NG TRUE)
    elseif(_backend STREQUAL "ISAL")
        set(CONFLUX_ENABLE_GZIP_ISAL TRUE)
    endif()
endforeach()

set(CONFLUX_GZIP_BACKENDS "")
if(CONFLUX_ENABLE_GZIP_ZLIB)
    set(CONFLUX_HAS_ZLIB "true")
    list(APPEND CONFLUX_GZIP_BACKENDS "zlib")
else()
    set(CONFLUX_HAS_ZLIB "false")
endif()
if(CONFLUX_ENABLE_GZIP_LIBDEFLATE)
    list(APPEND CONFLUX_GZIP_BACKENDS "libdeflate")
endif()
if(CONFLUX_ENABLE_GZIP_ZLIB_NG)
    list(APPEND CONFLUX_GZIP_BACKENDS "zlib-ng")
endif()
if(CONFLUX_ENABLE_GZIP_ISAL)
    list(APPEND CONFLUX_GZIP_BACKENDS "isa-l")
endif()

if(NOT CONFLUX_WANT_HTTP_COMPRESSION)
    set(CONFLUX_HAS_COMPRESS "false")
elseif(CONFLUX_GZIP_BACKENDS)
    set(CONFLUX_HAS_COMPRESS "true")
    list(JOIN CONFLUX_GZIP_BACKENDS ", " CONFLUX_GZIP_BACKENDS_STR)
    message(STATUS "conflux: gzip enabled (${CONFLUX_GZIP_BACKENDS_STR})")
else()
    set(CONFLUX_HAS_COMPRESS "false")
    message(STATUS "conflux: gzip disabled (no gzip backend found)")
endif()

# ---- optional gzip backends ------------------------------------------------
if(NOT CONFLUX_WANT_HTTP_COMPRESSION)
    set(CONFLUX_HAS_LIBDEFLATE "false")
elseif(CONFLUX_ENABLE_GZIP_LIBDEFLATE)
    set(CONFLUX_HAS_LIBDEFLATE "true")
    message(STATUS "conflux: libdeflate enabled")
else()
    set(CONFLUX_HAS_LIBDEFLATE "false")
    if(NOT LIBDEFLATE_FOUND)
        message(STATUS "conflux: libdeflate disabled (libdeflate not found)")
    elseif(CONFLUX_GZIP_PROVIDER_UPPER STREQUAL "AUTO")
        message(STATUS "conflux: libdeflate disabled (gzip AUTO selected ${CONFLUX_RESOLVED_GZIP_PROVIDER})")
    else()
        message(STATUS "conflux: libdeflate disabled (CONFLUX_GZIP_PROVIDER=${CONFLUX_GZIP_PROVIDER_UPPER})")
    endif()
endif()

if(NOT CONFLUX_WANT_HTTP_COMPRESSION)
    set(CONFLUX_HAS_ZLIB_NG "false")
elseif(CONFLUX_ENABLE_GZIP_ZLIB_NG)
    set(CONFLUX_HAS_ZLIB_NG "true")
    message(STATUS "conflux: zlib-ng enabled")
else()
    set(CONFLUX_HAS_ZLIB_NG "false")
    if(NOT ZLIB_NG_FOUND)
        message(STATUS "conflux: zlib-ng disabled (zlib-ng not found)")
    elseif(CONFLUX_GZIP_PROVIDER_UPPER STREQUAL "AUTO")
        message(STATUS "conflux: zlib-ng disabled (gzip AUTO selected ${CONFLUX_RESOLVED_GZIP_PROVIDER})")
    else()
        message(STATUS "conflux: zlib-ng disabled (CONFLUX_GZIP_PROVIDER=${CONFLUX_GZIP_PROVIDER_UPPER})")
    endif()
endif()

if(NOT CONFLUX_WANT_HTTP_COMPRESSION)
    set(CONFLUX_HAS_ISAL "false")
elseif(CONFLUX_ENABLE_GZIP_ISAL)
    set(CONFLUX_HAS_ISAL "true")
    message(STATUS "conflux: isa-l enabled")
else()
    set(CONFLUX_HAS_ISAL "false")
    if(NOT LIBISAL_FOUND)
        message(STATUS "conflux: isa-l disabled (libisal not found)")
    elseif(CONFLUX_GZIP_PROVIDER_UPPER STREQUAL "AUTO")
        message(STATUS "conflux: isa-l disabled (gzip AUTO selected ${CONFLUX_RESOLVED_GZIP_PROVIDER})")
    else()
        message(STATUS "conflux: isa-l disabled (CONFLUX_GZIP_PROVIDER=${CONFLUX_GZIP_PROVIDER_UPPER})")
    endif()
endif()

# ---- brotli ----------------------------------------------------------------
string(TOUPPER "${CONFLUX_BROTLI_PROVIDER}" CONFLUX_BROTLI_PROVIDER_UPPER)
if(NOT CONFLUX_BROTLI_PROVIDER_UPPER MATCHES "^(AUTO|SYSTEM|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_BROTLI_PROVIDER must be AUTO, SYSTEM, or OFF "
        "(got '${CONFLUX_BROTLI_PROVIDER}')")
endif()
