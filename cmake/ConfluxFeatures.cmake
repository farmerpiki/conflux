        message(STATUS "conflux: brotli disabled (libbrotlienc/libbrotlidec not found)")
    endif()
endif()
if(NOT CONFLUX_WANT_HTTP_COMPRESSION OR CONFLUX_BROTLI_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_RESOLVED_BROTLI_PROVIDER "OFF" CACHE STRING "Resolved Brotli provider" FORCE)
endif()

# ---- zstd ------------------------------------------------------------------
string(TOUPPER "${CONFLUX_ZSTD_PROVIDER}" CONFLUX_ZSTD_PROVIDER_UPPER)
if(NOT CONFLUX_ZSTD_PROVIDER_UPPER MATCHES "^(AUTO|SYSTEM|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_ZSTD_PROVIDER must be AUTO, SYSTEM, or OFF "
        "(got '${CONFLUX_ZSTD_PROVIDER}')")
endif()
if(CONFLUX_WANT_HTTP_COMPRESSION
        AND CONFLUX_ZSTD_PROVIDER_UPPER STREQUAL "SYSTEM"
        AND NOT ZSTD_FOUND)
    message(FATAL_ERROR "conflux: CONFLUX_ZSTD_PROVIDER=SYSTEM requires libzstd")
endif()
if(NOT CONFLUX_WANT_HTTP_COMPRESSION OR CONFLUX_ZSTD_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_HAS_ZSTD "false")
elseif(ZSTD_FOUND)
    set(CONFLUX_HAS_ZSTD "true")
    set(CONFLUX_RESOLVED_ZSTD_PROVIDER "SYSTEM" CACHE STRING "Resolved zstd provider" FORCE)
    message(STATUS "conflux: zstd enabled")
else()
    set(CONFLUX_HAS_ZSTD "false")
    set(CONFLUX_RESOLVED_ZSTD_PROVIDER "OFF" CACHE STRING "Resolved zstd provider" FORCE)
    if(NOT ZSTD_FOUND)
        message(STATUS "conflux: zstd disabled (libzstd not found)")
    endif()
endif()
if(NOT CONFLUX_WANT_HTTP_COMPRESSION OR CONFLUX_ZSTD_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_RESOLVED_ZSTD_PROVIDER "OFF" CACHE STRING "Resolved zstd provider" FORCE)
endif()

# ---- Prometheus metrics (no external dep) ----------------------------------
if(CONFLUX_ENABLE_METRICS)
    set(CONFLUX_HAS_METRICS "true")
    message(STATUS "conflux: metrics enabled")
else()
    set(CONFLUX_HAS_METRICS "false")
    message(STATUS "conflux: metrics disabled")
endif()

# ---- HTTP/2 (requires nghttp2 + TLS) ---------------------------------------
string(TOUPPER "${CONFLUX_HTTP2_PROVIDER}" CONFLUX_HTTP2_PROVIDER_UPPER)
if(NOT CONFLUX_HTTP2_PROVIDER_UPPER MATCHES "^(AUTO|NGHTTP2|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_HTTP2_PROVIDER must be AUTO, NGHTTP2, or OFF "
        "(got '${CONFLUX_HTTP2_PROVIDER}')")
endif()
if((CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT)
        AND CONFLUX_HTTP2_PROVIDER_UPPER STREQUAL "NGHTTP2"
        AND (NOT NGHTTP2_FOUND OR NOT CONFLUX_HAS_TLS STREQUAL "true"))
    message(FATAL_ERROR "conflux: CONFLUX_HTTP2_PROVIDER=NGHTTP2 requires libnghttp2 and TLS")
endif()
if(NOT (CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT)
        OR CONFLUX_HTTP2_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_HAS_HTTP2 "false")
elseif(NGHTTP2_FOUND AND CONFLUX_HAS_TLS STREQUAL "true")
    set(CONFLUX_HAS_HTTP2 "true")
    set(CONFLUX_RESOLVED_HTTP2_PROVIDER "NGHTTP2" CACHE STRING "Resolved HTTP/2 provider" FORCE)
    message(STATUS "conflux: HTTP/2 enabled (nghttp2)")
else()
    set(CONFLUX_HAS_HTTP2 "false")
    set(CONFLUX_RESOLVED_HTTP2_PROVIDER "OFF" CACHE STRING "Resolved HTTP/2 provider" FORCE)
    if(NOT NGHTTP2_FOUND)
        message(STATUS "conflux: HTTP/2 disabled (libnghttp2 not found)")
    elseif(NOT CONFLUX_HAS_TLS STREQUAL "true")
        message(STATUS "conflux: HTTP/2 disabled (TLS required)")
    endif()
endif()
if(NOT (CONFLUX_WANT_HTTP_SERVER OR CONFLUX_WANT_HTTP_CLIENT)
        OR CONFLUX_HTTP2_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_RESOLVED_HTTP2_PROVIDER "OFF" CACHE STRING "Resolved HTTP/2 provider" FORCE)
endif()

# ---- HTTP/3 (requires ngtcp2 + nghttp3 + OpenSSL 3.5+ + TLS) ---------------
string(TOUPPER "${CONFLUX_HTTP3_PROVIDER}" CONFLUX_HTTP3_PROVIDER_UPPER)
if(NOT CONFLUX_HTTP3_PROVIDER_UPPER MATCHES "^(AUTO|NGTCP2_NGHTTP3_OPENSSL|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_HTTP3_PROVIDER must be AUTO, NGTCP2_NGHTTP3_OPENSSL, or OFF "
        "(got '${CONFLUX_HTTP3_PROVIDER}')")
endif()
if(CONFLUX_WANT_HTTP_SERVER
        AND CONFLUX_HTTP3_PROVIDER_UPPER STREQUAL "NGTCP2_NGHTTP3_OPENSSL"
        AND NOT CONFLUX_ENABLE_EXPERIMENTAL)
    message(FATAL_ERROR
        "conflux: explicit HTTP/3 provider requires CONFLUX_ENABLE_EXPERIMENTAL=ON")
endif()
set(CONFLUX_HAS_HTTP3_OPENSSL "false")
if(OpenSSL_FOUND AND OPENSSL_VERSION VERSION_GREATER_EQUAL "3.5.0")
    set(CONFLUX_HAS_HTTP3_OPENSSL "true")
endif()

if(CONFLUX_WANT_HTTP_SERVER
        AND NOT CONFLUX_HTTP3_PROVIDER_UPPER STREQUAL "OFF"
        AND NOT CONFLUX_ENABLE_EXPERIMENTAL)
    message(STATUS "conflux: HTTP/3 deps may be present; disabled because CONFLUX_ENABLE_EXPERIMENTAL=OFF")
endif()

if(NOT CONFLUX_WANT_HTTP_SERVER OR CONFLUX_HTTP3_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_HAS_HTTP3 "false")
elseif(NGTCP2_FOUND AND NGTCP2_CRYPTO_OSSL_FOUND AND NGHTTP3_FOUND
        AND CONFLUX_HAS_TLS STREQUAL "true"
        AND CONFLUX_HAS_HTTP3_OPENSSL STREQUAL "true"
        AND CONFLUX_ENABLE_EXPERIMENTAL)
    set(CONFLUX_HAS_HTTP3 "true")
    set(CONFLUX_RESOLVED_HTTP3_PROVIDER "NGTCP2_NGHTTP3_OPENSSL" CACHE STRING "Resolved HTTP/3 provider" FORCE)
    message(STATUS "conflux: HTTP/3 enabled (ngtcp2 ${NGTCP2_VERSION}, nghttp3 ${NGHTTP3_VERSION})")
else()
    set(CONFLUX_HAS_HTTP3 "false")
    set(CONFLUX_RESOLVED_HTTP3_PROVIDER "OFF" CACHE STRING "Resolved HTTP/3 provider" FORCE)
    if(NOT CONFLUX_ENABLE_EXPERIMENTAL)
        message(STATUS "conflux: HTTP/3 disabled (CONFLUX_ENABLE_EXPERIMENTAL=OFF)")
    elseif(NOT NGTCP2_FOUND)
        message(STATUS "conflux: HTTP/3 disabled (libngtcp2 not found)")
    elseif(NOT NGTCP2_CRYPTO_OSSL_FOUND)
        message(STATUS "conflux: HTTP/3 disabled (libngtcp2_crypto_ossl not found)")
    elseif(NOT NGHTTP3_FOUND)
        message(STATUS "conflux: HTTP/3 disabled (libnghttp3 not found)")
    elseif(NOT CONFLUX_HAS_TLS STREQUAL "true")
        message(STATUS "conflux: HTTP/3 disabled (TLS required)")
    elseif(NOT CONFLUX_HAS_HTTP3_OPENSSL STREQUAL "true")
        message(STATUS "conflux: HTTP/3 disabled (OpenSSL ${OPENSSL_VERSION} < 3.5.0)")
    endif()
endif()
if(NOT CONFLUX_WANT_HTTP_SERVER OR CONFLUX_HTTP3_PROVIDER_UPPER STREQUAL "OFF")
    set(CONFLUX_RESOLVED_HTTP3_PROVIDER "OFF" CACHE STRING "Resolved HTTP/3 provider" FORCE)
endif()

# ---- Postgres (libpq) ------------------------------------------------------
string(TOUPPER "${CONFLUX_POSTGRES_PROVIDER}" CONFLUX_POSTGRES_PROVIDER_UPPER)
if(NOT CONFLUX_POSTGRES_PROVIDER_UPPER MATCHES "^(AUTO|LIBPQ|OFF)$")
    message(FATAL_ERROR
        "conflux: CONFLUX_POSTGRES_PROVIDER must be AUTO, LIBPQ, or OFF "
