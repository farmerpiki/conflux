{
    "port": 8000,
    "rings": 0,
    "workers": 1,
    "ring_entries": 1024,
    "max_body_size": 1048576,
    "request_timeout_ms": 30000,
    "tls_sniff_timeout_ms": 10000,
    "parser_limits": {
        "max_request_line_size": 8192,
        "max_header_line_size": 8192,
        "max_headers": 100,
        "max_header_block_size": 65536,
        "max_chunks": 100000
    },
    "io_uring_flags": {
        "single_issuer": true,
        "defer_taskrun": true,
        "sqpoll": false,
        "coop_taskrun": true,
        "taskrun_flag": true,
        "submit_all": false
    },
    "auth": {
        "password_verifier_secret_env": "CONFLUX_AUTH_PASSWORD_PEPPER",
        "password_verifier_min_secret_bytes": 16,
        "jwt_secret_env": "CONFLUX_AUTH_JWT_SECRET",
        "jwt_previous_secret_env": "CONFLUX_AUTH_JWT_PREVIOUS_SECRET",
        "jwt_min_secret_bytes": 16,
        "cookie_secret_env": "CONFLUX_AUTH_COOKIE_SECRET",
        "cookie_previous_secret_env": "CONFLUX_AUTH_COOKIE_PREVIOUS_SECRET",
        "cookie_min_secret_bytes": 16,
        "session_secret_env": "CONFLUX_AUTH_SESSION_SECRET",
        "session_previous_secret_env": "CONFLUX_AUTH_SESSION_PREVIOUS_SECRET",
        "session_min_secret_bytes": 16,
        "comment": "Unset secrets fail closed; prefer env/file secret injection over literal values."
    }
}
